[
{"id":"biz-cart-increment","title":"주문 수량의 묶음 단위 확인","category":"고객 경험","pattern":"agent","problem":"최소 주문량과 증분 단위를 동시에 검사한다.","input":"희망7개,최소4개,추가2개단위","facts":"합성 판매조건:허용4/6/8/...개.","output":"7개불가,인접허용6개또는8개","rules":["최소량부터 증분 적용","수량을 몰래 올리지 않음","두 인접 후보 표시"],"failures":["주문 실행 금지","단위0은 설정 오류"]},
{"id":"biz-preorder-mixed-cart","title":"예약 상품 혼합 주문의 출고 선택","category":"고객 경험","pattern":"agent","problem":"즉시 상품과 예약 상품의 합배송 지연을 설명한다.","input":"A즉시출고,B다음달출고,합배송선택","facts":"합성:합배송은 모든 상품 준비 후 출고,분리배송은 추가비용 미확인.","output":"A도다음달출고대기,분리배송비확인후선택","rules":["상품 준비일과 주문일 구분","합배송 조건 적용","비용 미상은 금액 생성 금지"],"failures":["배송방식 변경 금지","도착일 보장 금지"]},
{"id":"biz-cart-incompatible-addons","title":"부가 옵션 간 동시 선택 제한","category":"고객 경험","pattern":"agent","problem":"서로 양립할 수 없는 부가 옵션을 주문 초안에서 찾는다.","input":"각인과빠른출고동시선택","facts":"합성:각인 가공에는2일 필요,빠른출고는 가공없는 상품만.","output":"두옵션동시불가,우선할옵션확인","rules":["기본 상품 가능 여부와 옵션 충돌 구분","선택을 임의 삭제하지 않음","충돌 원인을 표시"],"failures":["주문 수정 금지","각인 문구 생성 금지"]},
{"id":"biz-pickup-id-requirements","title":"대리 수령 준비 서류 안내","category":"고객 경험","pattern":"rag","problem":"본인 수령과 대리 수령에 필요한 확인 항목을 구분한다.","input":"친구가대신받음,주문번호만준비","facts":"합성 매장정책:대리수령은 주문번호와 구매자의 대리수령 지정 확인 필요. 신분증 사본 불필요.","output":"대리수령지정확인추가필요,신분증사본요청없음","rules":["대리 여부 먼저 확인","정책에 없는 개인정보 요청 금지","지정 확인과 실제 수령 구분"],"failures":["수령 승인 금지","실제 매장 규정으로 단정 금지"]},
{"id":"biz-personalization-preview","title":"맞춤 제작 시안과 입력 비교","category":"고객 경험","pattern":"review","problem":"제작 시안이 고객이 확정한 문구·대소문자·줄바꿈을 보존하는지 확인한다.","input":"입력Hello\nMina,시안HELLO Mina","facts":"합성:대소문자와 줄바꿈 모두 확정 입력대로 제작.","output":"대문자변경·줄바꿈누락확인","rules":["공백 차이도 별도 표시","오탈자로 판단해 자동 교정 금지","시안 승인 전에 차이 확인"],"failures":["제작 승인 금지","고객 이름 유추 금지"]},
{"id":"biz-gift-message-privacy","title":"선물 주문 가격 노출 항목","category":"고객 경험","pattern":"review","problem":"선물 수령인에게 제공할 동봉물에서 가격 노출 조건을 점검한다.","input":"선물포장선택,동봉청구서금액표시있음","facts":"합성:선물 주문 수령인 동봉물에는 가격 제외,구매자 영수증은 별도.","output":"동봉청구서가격제외필요,구매자영수증별도보존","rules":["구매자와 수령인 문서 구분","세무 영수증 자체 삭제로 해석 금지","선물 메시지는 별도 확인"],"failures":["문서 발송·삭제 금지","실제 규정 보장 금지"]},
{"id":"biz-coupon-minimum-basis","title":"쿠폰 최소금액의 산정 대상","category":"고객 경험","pattern":"agent","problem":"배송비와 제외 상품을 빼고 쿠폰 적용 기준금액을 계산한다.","input":"상품A3만원/제외B2만원/배송3천원,기준4만원","facts":"합성:쿠폰 기준은 적용대상 상품액만,배송비 제외.","output":"기준액3만원으로1만원부족","rules":["결제 총액과 기준액 구분","제외 상품을 더하지 않음","부족액을 정확히 표시"],"failures":["쿠폰 사용 실행 금지","정책 미상은 확인"]},
{"id":"biz-coupon-one-per-order","title":"쿠폰 단위가 상품인지 주문인지 확인","category":"고객 경험","pattern":"agent","problem":"정액 쿠폰이 주문 전체에 한 번 적용되는지 항목별인지 대조한다.","input":"상품2개각1만원,주문당3천원쿠폰","facts":"합성:주문당1회,항목별중복불가.","output":"총2만원에서3천원차감,1만7천원","rules":["주문 수와 상품 수 구분","할인액은 대상금액 초과 금지","다른 할인은 미제공으로 제외"],"failures":["결제 실행 금지","정책 없는 중복 적용 금지"]},
{"id":"biz-loyalty-expiry-order","title":"적립금 사용의 만료 우선순위","category":"고객 경험","pattern":"agent","problem":"사용 예정 적립금을 만료가 빠른 잔액부터 차감한 결과를 제시한다.","input":"A500점내일만료,B800점다음달만료,사용600점","facts":"합성:선입선출 대신 만료일 우선,현금 전환 없음.","output":"A500+B100사용안,B700잔여","rules":["만료된 잔액은 사용 후보 제외","정확한 사용량만 배분","잔여 만료일도 보존"],"failures":["적립금 차감 실행 금지","날짜 미상은 확인"]},
{"id":"biz-referral-selfcheck","title":"추천인과 신규 가입자의 동일 계정","category":"고객 경험","pattern":"agent","problem":"추천 보상 신청에서 자기 추천과 정상 후보를 내부 ID로 구분한다.","input":"추천인U1,가입자U1","facts":"합성:동일계정 자기추천 불가,같은 이름만으로 동일인 판단 금지.","output":"동일계정으로보상대상제외후보","rules":["서버 제공 계정ID만 비교","가족·동명이인 추정 금지","다른 조건 충족은 별도 확인"],"failures":["보상 지급·차단 금지","사기 의도 단정 금지"]},
{"id":"biz-giftcard-partial-payment","title":"기프트 잔액과 추가 결제액","category":"고객 경험","pattern":"agent","problem":"사용 가능한 기프트 잔액을 적용한 뒤 남는 금액을 산정한다.","input":"주문27000원,기프트잔액20000원","facts":"합성:부분결제허용,현금잔돈반환없음.","output":"기프트20000원,추가결제7000원","rules":["잔액을 초과 사용하지 않음","추가결제와 현금반환 구분","여러 카드 합산은 허용정보 필요"],"failures":["카드번호 요청 금지","결제 실행 금지"]},
{"id":"biz-exchange-difference","title":"교환 상품 차액 안내","category":"고객 경험","pattern":"agent","problem":"교환 승인 후 대체 상품 가격 차이와 배송 비용을 분리한다.","input":"원상품3만원,대체3만5천원,교환배송2천원","facts":"합성:교환은이미검토승인됨,포인트조정없음.","output":"상품차액5000원,배송2000원,총추가7000원","rules":["교환 가능 여부를 다시 확정하지 않음","차액과 물류비 분리","음수 차액은 환급 검토로 표시"],"failures":["실제 교환·청구 금지","세금 조건 누락은 확인"]},
{"id":"biz-order-amendment-freeze","title":"주문 변경 마감 상태 확인","category":"고객 경험","pattern":"agent","problem":"포장 시작 여부에 따라 주소 변경 요청의 다음 단계를 안내한다.","input":"상태포장중,주소변경요청","facts":"합성:포장전만셀프변경,포장후물류담당확인필요.","output":"셀프변경불가,물류담당확인필요","rules":["주문 생성시간보다 현재 상태 사용","배송 완료와 포장 중 구분","가능성과 실제 변경 구분"],"failures":["주소 원문 요청 금지","주소 변경 실행 금지"]},
{"id":"biz-shipping-fee-threshold","title":"묶음 배송 무료 조건 분리","category":"고객 경험","pattern":"agent","problem":"판매자별 무료 배송 기준을 장바구니 전체 합계와 구분한다.","input":"판매자A3만원/B3만원,각5만원이상무료","facts":"합성:판매자별 배송비2500원,판매자 간 합산 불가.","output":"둘다기준미달,배송비합5000원","rules":["판매자별 금액으로 계산","장바구니6만원으로 무료 판단 금지","묶음 가능 판매자만 합산"],"failures":["배송비 청구 금지","실제 판매조건 주장 금지"]},
{"id":"biz-delivery-instructions-conflict","title":"배송 요청 문구의 상충 조건","category":"고객 경험","pattern":"review","problem":"수령 요청에서 동시에 지킬 수 없는 조건을 찾아 확인 질문을 만든다.","input":"문앞두세요,반드시직접서명받으세요","facts":"합성:비대면문앞배송과직접서명은같은배송에서동시불가.","output":"문앞보관과직접서명중우선조건확인","rules":["서로 충돌하는 요청을 함께 표시","임의 우선순위 선택 금지","해결에 필요한 질문만 생성"],"failures":["배송지 변경 금지","배송기사 행동 단정 금지"]},
{"id":"biz-sample-return-accounting","title":"체험용 샘플의 회수 대상 구분","category":"고객 경험","pattern":"agent","problem":"반납해야 할 대여 샘플과 소모 가능한 동봉품을 구분한다.","input":"키트기기D/패드P/케이블C","facts":"합성:회수대상D/C,패드P는소모품반납불필요.","output":"D/C반납목록,P반납제외","rules":["구성품 전체를 반납으로 묶지 않음","기기 일련번호는 제공값만 사용","누락 회수품 표시"],"failures":["택배 접수 금지","위생·폐기 방법 추정 금지"]},
{"id":"biz-promo-stock-reservation","title":"장바구니와 재고 확보의 차이","category":"고객 경험","pattern":"agent","problem":"장바구니 저장이 상품 재고를 보장하는지 정책에 맞게 안내한다.","input":"장바구니저장3시간,상품품절","facts":"합성:재고확보는결제완료시점,장바구니예약없음.","output":"장바구니저장은재고예약아님,현재품절확인","rules":["저장과 결제 상태 구분","이전 표시 재고를 현재로 사용하지 않음","재입고 일정은 근거 있을 때만 안내"],"failures":["재고 생성·예약 금지","고객 잘못으로 표현 금지"]},
{"id":"biz-product-comparison-units","title":"상품 용량 비교의 단위 통일","category":"고객 경험","pattern":"agent","problem":"팩 수와 개당 용량을 환산해 제공량을 같은 단위로 비교한다.","input":"A250mL4개,B1L1개","facts":"합성:모든제품내용물동일가정,가격미제공.","output":"둘다1000mL로총량같음,포장형태는다름","rules":["팩 수만으로 많음 판단 금지","단위 환산 과정을 표시","가격 효율은 별도 입력 필요"],"failures":["품질 동일성 일반화 금지","구매 실행 금지"]},
{"id":"biz-size-chart-measurement","title":"치수표의 측정 방식 구분","category":"고객 경험","pattern":"agent","problem":"단면 치수와 둘레 치수를 혼동한 비교를 바로잡는다.","input":"의류가슴단면50cm,사용자둘레96cm","facts":"합성:의류둘레는단면x2,여유량은4cm. 착용감 기준은 미제공.","output":"의류둘레100cm,계산상여유4cm","rules":["단면과 둘레 단위 구분","신체 치수 원문 최소 사용","여유량과 적정 사이즈 확정 구분"],"failures":["착용 적합 보장 금지","신체 평가 금지"]},
{"id":"biz-instalment-total","title":"분납 안내의 총액 일치","category":"고객 경험","pattern":"agent","problem":"분할 납부 안내의 횟수·회당액이 표시 총액과 일치하는지 검토한다.","input":"총12만원,월2만원x6회,추가수수료5천원별도","facts":"합성 표시검토이며 금융상품 권유 아님.","output":"분납원금12만원일치,총부담12만5천원표시필요","rules":["원금 합계와 추가비용 분리","회당액만 강조해 총액 누락 금지","수수료 미상은 미확인"],"failures":["결제·대출 신청 금지","재무 적합성 조언 아님"]},
{"id":"biz-installation-site-check","title":"설치 서비스 사전 공간 조건","category":"고객 경험","pattern":"agent","problem":"상품 설치에 필요한 공간과 제공된 현장 치수를 대조한다.","input":"필요폭80cm/후면여유10cm,공간폭85cm/후면5cm","facts":"합성 설치안내값이며 현장 안전 점검 아님.","output":"폭충족,후면5cm부족","rules":["제품 폭과 필수 여유를 구분","모든 방향 조건 확인","미측정 치수는 적합 판단 제외"],"failures":["실제 설치 가능 보장 금지","전기·구조 변경 안내 금지"]},
{"id":"biz-rental-extension-availability","title":"대여 연장과 후속 예약 충돌","category":"고객 경험","pattern":"agent","problem":"연장 요청 기간이 다음 예약의 준비 시작을 침범하는지 확인한다.","input":"현재반납10일,연장12일까지,다음예약12일/점검1일","facts":"합성:다음예약전날부터점검,끝날은포함.","output":"11일점검필요,12일까지연장불가후보","rules":["예약 시작뿐 아니라 준비일 포함","기간 경계 포함 여부 표시","확정 예약을 임의 취소하지 않음"],"failures":["연장 승인 금지","대체 재고 추정 금지"]},
